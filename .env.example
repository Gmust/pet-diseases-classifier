GEMINI_API_KEY=your_gemini_api_key_here
# Optional: extra keys for quota rotation, comma-separated. A 429 (quota
# exhausted) on one key rotates to the next before falling back to the
# local template. GEMINI_API_KEY is always tried first.
GEMINI_API_KEYS=key2,key3,key4,key5
GEMINI_MODEL=gemini-2.5-flash

# Optional for local development. If unset, /predict auth is disabled.
API_KEY=your_secret_api_key_here

# Path to the fine-tuned transformer model directory (produced by app/ml/train.py)
MODEL_PATH=models/transformer_model
MODEL_BACKEND=torch

# Confidence below this threshold triggers a "seek vet advice" warning
LOW_CONFIDENCE_THRESHOLD=0.65

# Optional: skip Gemini for /predict and use reviewed static explanations
USE_STATIC_EXPLANATIONS=false

LOG_LEVEL=INFO
ROOT_PATH=
